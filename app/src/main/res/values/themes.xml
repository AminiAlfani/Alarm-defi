<resources>
    <style name="Theme.AlarmeDefi" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FF453A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF9F0A</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#1C1C1E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#2C2C2E</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorEdgeEffect">#FF9F0A</item>
    </style>

    <style name="Theme.AlarmeDefi.TimePickerDialog" parent="ThemeOverlay.Material3.Dark.Dialog">
        <item name="colorPrimary">#FF9F0A</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSurface">#1C1C1E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#2C2C2E</item>
        <item name="android:windowBackground">#1C1C1E</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E8E93</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AlarmeDefi.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AlarmeDefi.DialogButton.Negative</item>
    </style>

    <style name="Widget.AlarmeDefi.DialogButton.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#FF9F0A</item>
    </style>

    <style name="Widget.AlarmeDefi.DialogButton.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#8E8E93</item>
    </style>
</resources>
